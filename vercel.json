{
  "cleanUrls": true,
  "redirects": [
    { "source": "/admin", "destination": "/heures", "permanent": false }
  ],
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/auto-close-punches", "schedule": "0 0 * * *" }
  ]
}
